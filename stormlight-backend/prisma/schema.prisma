generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(cuid())
  discordId               String   @unique @map("discord_id")
  username                String
  discriminator           String?
  avatar                  String?
  email                   String?
  roles                   String[] @default([])
  preferences             Json?
  selectedBadgeId         String?  @map("selected_badge_id")
  lastLoginAt             DateTime? @map("last_login_at")
  lastSeenAt              DateTime? @map("last_seen_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ClanMember {
  id                 String             @id @default(cuid())
  username           String             @unique
  displayName        String?            @map("display_name")
  clanRank           String             @map("clan_rank")
  totalXp            BigInt             @map("total_xp")
  totalLevel         Int                @map("total_level")
  combatLevel        Int                @map("combat_level")
  questPoints        Int                @default(0) @map("quest_points")
  kills              Int                @default(0)
  stats              Json?
  questData          Json?              @map("quest_data")
  lastUpdated        DateTime           @map("last_updated")
  createdAt          DateTime           @default(now()) @map("created_at")
  discordId          String?            @unique @map("discord_id")
  badges             Json?              @default("[]")
  joinDate           DateTime?          @map("join_date")
  active             Boolean            @default(true)
  lastSeenInApi      DateTime?          @map("last_seen_in_api")
  leftAt             DateTime?          @map("left_at")
  totalCaps          Int                @default(0) @map("total_caps")
  competitionEntries CompetitionEntry[]

  @@index([discordId], map: "idx_clan_members_discord_id")
  @@index([active])
  @@map("clan_members")
}

model Competition {
  id               String             @id @default(cuid())
  name             String
  slug             String?            @unique
  description      String?
  type             CompetitionType
  skill            String?
  boardSize        Int?               @map("board_size")
  dropsGrid        Json?              @map("drops_grid")
  startDate        DateTime           @map("start_date")
  endDate          DateTime           @map("end_date")
  isActive         Boolean            @default(true) @map("is_active")
  createdBy        String?            @map("created_by")
  rewardFirstGp    BigInt?            @map("reward_first_gp")
  rewardSecondGp   BigInt?            @map("reward_second_gp")
  rewardThirdGp    BigInt?            @map("reward_third_gp")
  rewardBadgeId    String?            @map("reward_badge_id")
  awardBadge       Boolean            @default(false) @map("award_badge")
  isDxpEvent       Boolean            @default(false) @map("is_dxp_event")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  entries          CompetitionEntry[]
  rewardBadge      CustomBadge?       @relation(fields: [rewardBadgeId], references: [id], onDelete: SetNull)

  @@map("competitions")
}

model CompetitionEntry {
  id              String      @id @default(cuid())
  competitionId   String      @map("competition_id")
  memberId        String      @map("member_id")
  username        String
  xpStart         BigInt      @map("xp_start")
  xpEnd           BigInt?     @map("xp_end")
  xpGained        BigInt      @default(0) @map("xp_gained")
  dropsCompleted  Json?       @map("drops_completed")
  rank            Int?
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  competition     Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  member          ClanMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([competitionId, memberId])
  @@map("competition_entries")
}

model CustomBadge {
  id                      String        @id @default(cuid())
  name                    String
  description             String?
  imagePath               String        @map("image_path")
  imageUrl                String        @map("image_url")
  backgroundColor         String?       @map("background_color")
  gradientColors          Json?         @map("gradient_colors")
  allowUsernameColorOverride Boolean    @default(false) @map("allow_username_color_override")
  createdBy               String        @map("created_by")
  createdAt               DateTime      @default(now()) @map("created_at")
  competitions            Competition[]
  category                BadgeCategory @default(CUSTOM)
  isSystemBadge           Boolean       @default(false) @map("is_system_badge")
  skillName               String?       @map("skill_name")
  hierarchyPath           String?       @map("hierarchy_path")
  hierarchyTier           Int?          @map("hierarchy_tier")
  
  @@map("custom_badges")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   String   @map("admin_id")
  username  String
  action    String
  details   String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([timestamp])
  @@index([adminId])
  @@map("admin_logs")
}

model PlayerStatsHistory {
  id           Int      @id @default(autoincrement())
  username     String
  skillName    String   @map("skill_name")
  level        Int
  xp           BigInt
  rank         Int?
  combatLevel  Int?     @map("combat_level")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([username, skillName, snapshotDate])
  @@index([username, snapshotDate])
  @@index([username, snapshotDate], map: "idx_player_stats_username_date")
  @@map("player_stats_history")
}

model PlayerStatChanges {
  id          Int      @id @default(autoincrement())
  username    String
  skillName   String   @map("skill_name")
  date        DateTime @db.Date
  levelChange Int      @default(0) @map("level_change")
  xpChange    BigInt   @default(0) @map("xp_change")
  rankChange  Int      @default(0) @map("rank_change")
  xpToday     BigInt   @default(0) @map("xp_today")
  xpYesterday BigInt   @default(0) @map("xp_yesterday")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([username, skillName, date])
  @@index([username, date])
  @@index([username, date], map: "idx_player_changes_username_date")
  @@map("player_stat_changes")
}

model ClanActivity {
  id                Int      @id @default(autoincrement())
  username          String
  text              String
  details           String?
  activityDate      String   @map("activity_date")
  activityTimestamp BigInt   @map("activity_timestamp")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([username, text, activityTimestamp])
  @@index([activityTimestamp])
  @@index([username])
  @@index([username], map: "idx_activities_username")
  @@map("clan_activities")
}

model ClanDrop {
  id                Int       @id @default(autoincrement())
  username          String    @db.VarChar(255)
  itemName          String    @map("item_name") @db.VarChar(255)
  bossName          String    @map("boss_name") @db.VarChar(255)
  itemImageUrl      String?   @map("item_image_url")
  activityText      String    @map("activity_text")
  activityTimestamp BigInt    @map("activity_timestamp")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([username, itemName, activityTimestamp])
  @@index([activityTimestamp(sort: Desc)], map: "idx_drops_timestamp")
  @@index([username], map: "idx_drops_username")
  @@map("clan_drops")
}

model ClanLog {
  id        Int      @id @default(autoincrement())
  username  String
  eventType String   @map("event_type")
  oldRank   String?  @map("old_rank")
  newRank   String?  @map("new_rank")
  timestamp DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([username])
  @@map("clan_log")
}

model PlayerDailySnapshot {
  id           Int       @id @default(autoincrement())
  username     String    @db.VarChar(255)
  snapshotDate DateTime  @map("snapshot_date") @db.Date
  stats        Json
  combatLevel  Int?      @map("combat_level")
  totalXp      BigInt?   @map("total_xp")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([username, snapshotDate])
  @@index([snapshotDate], map: "idx_pds_date")
  @@index([username, snapshotDate], map: "idx_pds_username_date")
  @@map("player_daily_snapshots")
}

model AccountLinkRequest {
  id                   String              @id @default(cuid())
  primaryDiscordId     String              @map("primary_discord_id")
  primaryUsername      String              @map("primary_username")
  alternateUsername    String              @map("alternate_username")
  status               AccountLinkStatus   @default(PENDING)
  requestedAt          DateTime            @default(now()) @map("requested_at")
  reviewedAt           DateTime?           @map("reviewed_at")
  reviewedBy           String?             @map("reviewed_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([primaryDiscordId])
  @@index([status])
  @@map("account_link_requests")
}

enum CompetitionType {
  XP_GAIN
  LEVEL_GAIN
  BOSS_KILLS
  CUSTOM
}

enum AccountLinkStatus {
  PENDING
  APPROVED
  REJECTED
  UNLINKED
}

enum BadgeCategory {
  CUSTOM
  SKILL
  DXP
  PVM
  API
}
